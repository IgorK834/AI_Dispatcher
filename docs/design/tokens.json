{
  "$schema-note": "RoutePilot design tokens — Clear Route v3. Source of truth for colours, type, space and shape. apps/web maps them to CSS variables and the Tailwind theme (ADR-0015). Human-readable description: docs/design/README.md.",
  "version": "3.0.0",
  "color": {
    "ground": { "value": "#F4F5F7", "role": "page background" },
    "surface": { "value": "#FFFFFF", "role": "cards, sheets, dialogs, inputs" },
    "well": { "value": "#F7F8FA", "role": "table heads, inner panels, timeline track" },
    "line": { "value": "#E9EBEF", "role": "row dividers, meter track" },
    "lineStrong": { "value": "#D5D9E0", "role": "input and button borders, free pallet place outline" },
    "ink": { "value": "#1A1D23", "role": "primary text, vehicle drawing lines, done status" },
    "ink2": { "value": "#474C55", "role": "secondary text" },
    "ink3": { "value": "#656C76", "role": "tertiary text, captions, table heads" },
    "red": { "value": "#D42A22", "role": "the only accent: primary actions, active nav, route line, stop markers, focus ring, count badge, driving segment" },
    "redHover": { "value": "#B5221B", "role": "primary hover, red text on tints, error text" },
    "redTint": { "value": "#FDEDEC", "role": "active nav and selected fills, attention pills and banners" },
    "redSoft": { "value": "#F5AAA6", "role": "second data series: loading time, offer B cargo" },
    "redFade": { "value": "#F6BDB9", "role": "bottom stop of red chart-bar gradients (occupancy, engine result)" },
    "neutralData": { "value": "#B6BCC6", "role": "breaks, mass bars, baselines" },
    "restHatchA": { "value": "#E3E6EA", "role": "daily rest hatch, stripe 1" },
    "restHatchB": { "value": "#F1F2F4", "role": "daily rest hatch, stripe 2" },
    "window": { "value": "#CFE3F5", "role": "vehicle windows only (illustration)" },
    "scrim": { "value": "rgba(26, 29, 35, 0.45)", "role": "dialog backdrop" }
  },
  "status": {
    "done": { "bg": "#E6E8EC", "fg": "#1A1D23", "use": "assigned, valid, yes" },
    "attention": { "bg": "#FDEDEC", "fg": "#B5221B", "use": "assumption, conflict, needs a look" },
    "error": { "bg": "#D42A22", "fg": "#FFFFFF", "use": "error, rejected" },
    "info": { "bg": "#EFF1F4", "fg": "#474C55", "use": "derived value, waiting" },
    "quiet": { "bg": "#F4F5F7", "fg": "#5B626C", "use": "free, read-only, source" },
    "synthetic": { "bg": "#FFFFFF", "fg": "#474C55", "border": "#D5D9E0", "use": "SYNTHETIC DATA badge" }
  },
  "cargo": {
    "offerA": { "value": "#EC7A74", "text": "#1A1D23" },
    "offerB": { "value": "#F5AAA6", "text": "#1A1D23" },
    "offerC": { "value": "#FAD4D1", "text": "#1A1D23" },
    "offerD": { "value": "#F8BFBB", "text": "#1A1D23" },
    "offerE": { "value": "#FCE6E4", "text": "#1A1D23" },
    "stripe": { "value": "repeating-linear-gradient(90deg, rgba(255,255,255,0) 0 9px, rgba(255,255,255,0.45) 9px 11px)" },
    "free": { "bg": "#FFFFFF", "border": "1.5px dashed #C3C9D2" }
  },
  "timeline": {
    "driving": "#D42A22",
    "service": "#F5AAA6",
    "break": "#B6BCC6",
    "rest": "repeating-linear-gradient(135deg, #E3E6EA 0 5px, #F1F2F4 5px 10px)",
    "waiting": "#FFFFFF with 1px #D5D9E0 inset"
  },
  "font": {
    "body": { "family": "Inter", "weights": [400, 500, 600] },
    "display": { "family": "Inter Tight", "weights": [400, 500, 600, 700] },
    "mono": { "family": "JetBrains Mono", "weights": [400, 500] },
    "loading": "next/font/google (self-hosted at build time, no runtime request)"
  },
  "type": {
    "display": { "size": 40, "weight": 500, "lineHeight": 1.15, "tracking": "-0.025em", "font": "display" },
    "h1": { "size": 32, "weight": 500, "lineHeight": 1.15, "tracking": "-0.025em", "font": "display" },
    "h2": { "size": 18, "weight": 600, "lineHeight": 1.3, "tracking": "-0.01em", "font": "display" },
    "h3": { "size": 15, "weight": 600, "lineHeight": 1.4, "font": "body" },
    "body": { "size": 14, "weight": 400, "lineHeight": 1.5, "font": "body" },
    "small": { "size": 12, "weight": 400, "lineHeight": 1.5, "font": "body" },
    "eyebrow": { "size": 11.5, "weight": 600, "tracking": "0.06em", "transform": "uppercase", "font": "body" },
    "mono": { "size": 12.5, "weight": 400, "tracking": "-0.01em", "font": "mono" },
    "kpi": { "size": 28, "weight": 500, "tracking": "-0.02em", "font": "display", "numeric": "tabular-nums" }
  },
  "space": [4, 8, 12, 16, 24, 32, 40],
  "layout": {
    "pageMaxWidth": 1440,
    "pageGutter": 40,
    "cardPadding": 24,
    "gap": 16,
    "touchTarget": 44,
    "topBarHeight": 80
  },
  "radius": {
    "card": 16,
    "inner": 12,
    "control": 10,
    "segment": 8,
    "pill": 6,
    "round": 999
  },
  "shadow": {
    "card": "0 1px 2px rgba(26, 29, 35, 0.04), 0 0 0 1px rgba(26, 29, 35, 0.04)",
    "sheet": "0 24px 48px rgba(21, 21, 21, 0.10)",
    "segmentOn": "0 1px 2px rgba(26, 29, 35, 0.10)",
    "focusRing": "0 0 0 3px #FDEDEC"
  }
}
