{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routepilot.invalid/schemas/cities.schema.json",
  "title": "Demo city table",
  "description": "FEAT-002 FR-1 and FR-2: the fixed geography of the demo and the single-zone country map.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cities", "countryTimezones"],
  "properties": {
    "version": { "const": 1 },
    "cities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "countryCode", "lat", "lon", "timezone"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "timezone": { "type": "string", "pattern": "^[A-Za-z]+/[A-Za-z_]+$" }
        }
      }
    },
    "countryTimezones": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z]{2}$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z]+/[A-Za-z_]+$" }
    }
  }
}
